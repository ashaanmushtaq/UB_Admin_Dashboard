{
  "name": "ub-collection-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant Garments Wholesale ERP System Monorepo",
  "workspaces": [
    "admin-dashboard",
    "pos-pwa",
    "mobile-app"
  ],
  "scripts": {
    "dev:admin": "npm run dev --prefix admin-dashboard",
    "dev:pos": "npm run dev --prefix pos-pwa",
    "dev:mobile": "npm run start --prefix mobile-app",
    "build:admin": "npx --prefix admin-dashboard vite build",
    "build:pos": "npx --prefix pos-pwa vite build"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  },
  "keywords": [
    "multi-tenant",
    "erp",
    "garments",
    "gents-suits",
    "supabase",
    "pwa",
    "react-native"
  ],
  "author": "UB Collection Team",
  "license": "UNLICENSED"
}
